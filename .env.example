# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection URL (async driver for FastAPI, sync for Celery/Alembic)
DATABASE_URL=postgresql+asyncpg://codereview:codereview_dev@localhost:5432/codereview
DATABASE_SYNC_URL=postgresql+psycopg2://codereview:codereview_dev@localhost:5432/codereview

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PR_EVENTS_TOPIC=pr-events
KAFKA_CONSUMER_GROUP_ID=code-review-consumers

# ─── Weaviate Vector Store ────────────────────────────────────────────────────
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=

# ─── AI / LLM ─────────────────────────────────────────────────────────────────
# Anthropic (Claude) - primary orchestration model
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI (GPT-4o) - reflection/judge model
OPENAI_API_KEY=sk-proj-...

# ─── GitHub Integration ───────────────────────────────────────────────────────
# Webhook secret for HMAC verification
GITHUB_WEBHOOK_SECRET=your-webhook-secret-here

# GitHub App credentials
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/github-app.pem
# OR inline (base64 encoded PEM)
GITHUB_APP_PRIVATE_KEY=LS0tLS1CRUdJTi...

# GitHub OAuth (for dashboard auth)
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production-use-256-bit-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── LangSmith Tracing ───────────────────────────────────────────────────────
LANGSMITH_API_KEY=ls__...
LANGSMITH_PROJECT=code-review-prod
LANGCHAIN_TRACING_V2=true

# ─── Agent Configuration ─────────────────────────────────────────────────────
MAX_AGENT_STEPS=10
RISK_SCORE_THRESHOLD=0.7
# Risk score below which skip deep agents (0.0-1.0)
LOW_RISK_THRESHOLD=0.3
# Max concurrent PR reviews per worker
MAX_CONCURRENT_REVIEWS=4

# ─── OpenTelemetry ───────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=code-review-backend
OTEL_ENVIRONMENT=development

# ─── Semgrep ─────────────────────────────────────────────────────────────────
# Optional: Semgrep app token for cloud rules
SEMGREP_APP_TOKEN=
# Rules path (defaults to auto-downloaded rulesets)
SEMGREP_RULES_PATH=auto

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
API_V1_PREFIX=/api/v1

# ─── OSV.dev CVE Database ────────────────────────────────────────────────────
OSV_API_URL=https://api.osv.dev/v1
